# Every PHMASTER_* value is optional; defaults live in phmaster.config.Settings.
# Nested sections use a double underscore. Uncomment a line to override it.

# Console
# PHMASTER_CONSOLE__WIDTH=120                  # terminal width if unset
# PHMASTER_CONSOLE__HEIGHT=40                  # terminal height if unset
# PHMASTER_CONSOLE__COLOR_SYSTEM=auto          # auto, standard, 256, truecolor, windows
# PHMASTER_CONSOLE__NO_COLOR=false
# PHMASTER_CONSOLE__FORCE_TERMINAL=true        # detected automatically if unset
# PHMASTER_CONSOLE__QUIET=false
# PHMASTER_CONSOLE__SOFT_WRAP=false
# PHMASTER_CONSOLE__MARKUP=true
# PHMASTER_CONSOLE__EMOJI=true
# PHMASTER_CONSOLE__HIGHLIGHT=true
# PHMASTER_CONSOLE__TAB_SIZE=8

# Logging
# PHMASTER_LOG__LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR, CRITICAL
# PHMASTER_LOG__CONSOLE_LEVEL=DEBUG
# PHMASTER_LOG__FILE_LEVEL=INFO
# PHMASTER_LOG__FORMAT=console                 # console or json; file logs are always JSON
# PHMASTER_LOG__DIR=./logs                     # platform user log directory if unset
# PHMASTER_LOG__FILE_NAME=phmaster.log
# PHMASTER_LOG__FILE_MAX_BYTES=4194304
# PHMASTER_LOG__FILE_BACKUP_COUNT=5
