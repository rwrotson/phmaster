# Every CLI_APP_* value is optional; defaults live in cli_app.config.Settings.
# Nested sections use a double underscore. Uncomment a line to override it.

# Console
# CLI_APP_CONSOLE__WIDTH=120                  # terminal width if unset
# CLI_APP_CONSOLE__HEIGHT=40                  # terminal height if unset
# CLI_APP_CONSOLE__COLOR_SYSTEM=auto          # auto, standard, 256, truecolor, windows
# CLI_APP_CONSOLE__NO_COLOR=false
# CLI_APP_CONSOLE__FORCE_TERMINAL=true        # detected automatically if unset
# CLI_APP_CONSOLE__QUIET=false
# CLI_APP_CONSOLE__SOFT_WRAP=false
# CLI_APP_CONSOLE__MARKUP=true
# CLI_APP_CONSOLE__EMOJI=true
# CLI_APP_CONSOLE__HIGHLIGHT=true
# CLI_APP_CONSOLE__TAB_SIZE=8

# Logging
# CLI_APP_LOG__LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR, CRITICAL
# CLI_APP_LOG__CONSOLE_LEVEL=DEBUG
# CLI_APP_LOG__FILE_LEVEL=INFO
# CLI_APP_LOG__FORMAT=console                 # console or json; file logs are always JSON
# CLI_APP_LOG__DIR=./logs                     # platform user log directory if unset
# CLI_APP_LOG__FILE_NAME=cli-app.log
# CLI_APP_LOG__FILE_MAX_BYTES=4194304
# CLI_APP_LOG__FILE_BACKUP_COUNT=5
